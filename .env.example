# Get a key at https://web3forms.com/ — public key (baked into client) per Web3Forms React docs
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Comma-separated iframe hosts for repository-managed showcase demos.
# Wildcards are supported at the subdomain level, for example *.vercel.app.
SHOWCASE_IFRAME_HOSTS=*.vercel.app,mediadustry.com,*.mediadustry.com

# Offerteworkflow. Store secrets only in .env.local/Vercel Environment Variables.
# Create the Neon database via Vercel Marketplace and apply db/schema.sql first.
DATABASE_URL=
APP_BASE_URL=https://www.mediadustry.com
# Assign the actual quotation number before activating acceptance.
DIETWIEJ_QUOTE_ID=
DIETWIEJ_ACCESS_TOKEN=
DIETWIEJ_CUSTOMER_EMAIL=
DIETWIEJ_TERMS_VERSION=
DIETWIEJ_TERMS_TEXT=

# Admin authentication (use a random password of at least 20 characters and secrets of at least 32 bytes).
QUOTE_ADMIN_PASSWORD=
QUOTE_ADMIN_SECRET=
QUOTE_ADMIN_ID=mario
QUOTE_EVIDENCE_RETENTION_DAYS=
CRON_SECRET=

# Resend transactional email. No email sends without both values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ING bank details are server-only. No payment instructions render unless valid.
ING_BENEFICIARY_NAME=
ING_IBAN=
ING_PAYMENT_URL=
