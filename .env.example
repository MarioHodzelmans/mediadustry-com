# Resend: full-access server key is required for emails, contacts and the dedicated segment.
# Never prefix any of these secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
# The sender domain must be verified in Resend.
CONTACT_FROM_EMAIL=MEDIADUSTRY <website@mail.mediadustry.com>
CONTACT_TO_EMAIL=info@mediadustry.com
CONTACT_SITE_URL=https://www.mediadustry.com
# At least 32 cryptographically random characters; keep stable to preserve existing email links.
CONTACT_TOKEN_SECRET=
# Dedicated MEDIADUSTRY marketing segment. Send broadcasts only to this segment.
RESEND_SEGMENT_ID=
# Durable consent evidence, single-use state, distributed locks and abuse limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional exact origins for additional trusted previews/local production testing.
# The generated VERCEL_URL and VERCEL_BRANCH_URL are allowed automatically.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated iframe hosts for repository-managed showcase demos.
# Wildcards are supported at the subdomain level, for example *.vercel.app.
SHOWCASE_IFRAME_HOSTS=*.vercel.app,mediadustry.com,*.mediadustry.com
