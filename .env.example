# Get a key at https://web3forms.com/ — public key (baked into client) per Web3Forms React docs
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Website chat. The widget is on unless this is exactly "false" (kill switch).
# Requires a rebuild. On Vercel, AI Gateway uses OIDC automatically.
# Locally set AI_GATEWAY_API_KEY, or run `vercel link` and `vercel env pull` for OIDC.
# CHAT_MODEL is optional. Default is the free-tier model in lib/chat/models.ts.
# CHAT_MOCK=1 only works outside production and returns a fixed Dutch test reply.
NEXT_PUBLIC_CHAT_ENABLED=
CHAT_MODEL=
AI_GATEWAY_API_KEY=
CHAT_MOCK=

# Comma-separated iframe hosts for repository-managed showcase demos.
# Wildcards are supported at the subdomain level, for example *.vercel.app.
SHOWCASE_IFRAME_HOSTS=*.vercel.app,mediadustry.com,*.mediadustry.com

# Offerteworkflow. Store secrets only in .env.local/Vercel Environment Variables.
# Create the Neon database via Vercel Marketplace and apply db/schema.sql first.
DATABASE_URL=
APP_BASE_URL=https://www.mediadustry.com
# Assign the actual quotation number before activating acceptance.
DIETWIEJ_QUOTE_ID=
DIETWIEJ_ACCESS_TOKEN=
DIETWIEJ_TERMS_VERSION=
DIETWIEJ_TERMS_TEXT=

# Admin authentication (use a random password of at least 20 characters and secrets of at least 32 bytes).
QUOTE_ADMIN_PASSWORD=
QUOTE_ADMIN_SECRET=
QUOTE_ADMIN_ID=mario
QUOTE_EVIDENCE_RETENTION_DAYS=
CRON_SECRET=

# Resend. Quote mail needs RESEND_API_KEY and RESEND_FROM_EMAIL.
# Chat leads use the same RESEND_API_KEY with the contact inbox below,
# not RESEND_FROM_EMAIL and not a Web3Forms key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only contact inbox. Chat leads are sent from CONTACT_FROM_EMAIL
# to CONTACT_TO_EMAIL. No chat lead is stored or sent when the key or sender is missing.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@mediadustry.com

# ING bank details are server-only. No payment instructions render unless valid.
ING_BENEFICIARY_NAME=
ING_IBAN=
ING_PAYMENT_URL=
